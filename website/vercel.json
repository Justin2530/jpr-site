{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/jobs",
      "destination": "/api/jobs"
    },
    {
      "source": "/jobs/:id",
      "destination": "/api/job?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/nationwide-manufacturing",
      "destination": "/usa",
      "permanent": true
    },
    {
      "source": "/manufacturing",
      "destination": "/usa",
      "permanent": true
    }
  ]
}